---
import { Mail, Phone, Linkedin, Github, FileText, ArrowUpRight } from 'lucide-react';
---

<section id="contacto" class="py-24 px-4 sm:px-6 max-w-4xl mx-auto text-center scroll-mt-24">
  <div class="p-8 sm:p-12 rounded-3xl border border-slate-200/90 dark:border-white/10 bg-gradient-to-b from-white to-slate-50 dark:from-zinc-900/90 dark:to-[#11131a]/90 backdrop-blur-xl relative overflow-hidden shadow-xl dark:shadow-2xl">
    <!-- Ambient glow inside contact card -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-80 h-40 bg-brand/20 blur-3xl rounded-full pointer-events-none"></div>

    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-emerald-500/20 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-medium mb-4">
      <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
      Disponible para nuevas oportunidades
    </span>

    <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4 text-balance">
      ¿Hablamos de tu próximo proyecto?
    </h2>

    <p class="text-slate-600 dark:text-zinc-400 text-sm sm:text-base max-w-lg mx-auto mb-8 text-pretty">
      Estoy disponible para roles Full Stack (Frontend, Backend .NET o arquitecturas integrales), proyectos desafiantes y consultoría técnica.
    </p>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl mx-auto mb-10 text-left">
      <!-- Email -->
      <a
        href="mailto:jesudpf21@hotmail.com"
        class="p-4 rounded-2xl border border-slate-200/80 dark:border-white/10 bg-white/90 dark:bg-zinc-900/80 hover:bg-slate-50 dark:hover:bg-zinc-800/90 hover:border-brand/40 transition-all duration-200 group flex items-center justify-between shadow-sm"
      >
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-brand/10 text-brand group-hover:scale-105 transition-transform">
            <Mail className="w-5 h-5" />
          </div>
          <div>
            <div class="text-[11px] font-mono text-slate-500 dark:text-zinc-400">Correo directo</div>
            <div class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white group-hover:text-brand-accent transition-colors">
              jesudpf21@hotmail.com
            </div>
          </div>
        </div>
        <ArrowUpRight className="w-4 h-4 text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white transition-colors" />
      </a>

      <!-- WhatsApp / Phone -->
      <a
        href="https://wa.me/573002410510"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 rounded-2xl border border-slate-200/80 dark:border-white/10 bg-white/90 dark:bg-zinc-900/80 hover:bg-slate-50 dark:hover:bg-zinc-800/90 hover:border-emerald-500/40 transition-all duration-200 group flex items-center justify-between shadow-sm"
      >
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 group-hover:scale-105 transition-transform">
            <Phone className="w-5 h-5" />
          </div>
          <div>
            <div class="text-[11px] font-mono text-slate-500 dark:text-zinc-400">WhatsApp / Teléfono</div>
            <div class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white group-hover:text-emerald-500 dark:group-hover:text-emerald-400 transition-colors">
              +57 300 2410 510
            </div>
          </div>
        </div>
        <ArrowUpRight className="w-4 h-4 text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white transition-colors" />
      </a>
    </div>

    <!-- Direct Links Row -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://www.linkedin.com/in/jesus-perez-ferrer/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-slate-800 dark:text-zinc-200 bg-white dark:bg-zinc-900 hover:bg-slate-100 dark:hover:bg-zinc-800 border border-slate-200 dark:border-white/10 rounded-xl transition-colors shadow-sm"
      >
        <Linkedin className="w-4 h-4 text-[#0a66c2]" />
        LinkedIn
      </a>

      <a
        href="https://github.com/Hipns1"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-slate-800 dark:text-zinc-200 bg-white dark:bg-zinc-900 hover:bg-slate-100 dark:hover:bg-zinc-800 border border-slate-200 dark:border-white/10 rounded-xl transition-colors shadow-sm"
      >
        <Github className="w-4 h-4 text-slate-900 dark:text-white" />
        GitHub
      </a>

      <a
        href="/Jesus_Perez_HV_Desarrollador_I.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-brand hover:bg-brand-hover rounded-xl transition-all shadow-md shadow-brand/20"
      >
        <FileText className="w-4 h-4" />
        Descargar CV Completo
      </a>
    </div>
  </div>
</section>
