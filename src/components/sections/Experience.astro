---
import { Briefcase, Calendar, MapPin, CheckCircle2 } from 'lucide-react';

const experiences = [
  {
    role: "Desarrollador Full Stack",
    company: "Asisya",
    location: "Bogotá, Colombia (Remoto)",
    period: "2025-06 — Actualidad",
    current: true,
    impactBadge: "PeritoYa & Muévelo",
    highlights: [
      "Lideré la migración del frontend de PeritoYa a React 19, Vite 7 y Tailwind CSS 4, eliminando pérdidas de datos offline con Web Locks.",
      "Desarrollo full stack en .NET 10 con Clean Architecture, CQRS (MediatR), EF Core, Dapper y caché Redis.",
      "Desarrollo integral de Muévelo (Renting de vehículos): cotizador en tiempo real, MinIO S3 y Google Sheets API.",
      "Hardening de seguridad bancaria: protección CSRF, rate limiting por IP, firmas binarias y auditorías con Aikido."
    ],
    stack: ["React 19", ".NET 10", "TypeScript", "Clean Arch", "CQRS", "PostgreSQL", "Redis", "Docker"]
  },
  {
    role: "Semi-senior FrontEnd Developer",
    company: "Ditech (Outsourcing para Finanzauto)",
    location: "Bogotá, Colombia (Remoto)",
    period: "2024-04 — 2025-05",
    current: false,
    impactBadge: "Financiera a Gran Escala",
    highlights: [
      "Desarrollo de módulos interactivos de alta fidelidad con React.js, Vite y Tailwind CSS.",
      "Elaboración de código testeable, accesible y optimización de métricas Core Web Vitals para productos fintech."
    ],
    stack: ["React.js", "Vite", "Tailwind CSS", "TypeScript"]
  },
  {
    role: "FrontEnd Developer",
    company: "Kutai",
    location: "Medellín, Colombia",
    period: "2022-06 — 2024-02",
    current: false,
    impactBadge: "Librerías NPM & Componentes",
    highlights: [
      "Desarrollo de aplicaciones web con Next.js, TypeScript y SASS consumiendo APIs REST.",
      "Construcción y publicación de librerías NPM internas de componentes con StoryBook y Rollup.js."
    ],
    stack: ["Next.js", "TypeScript", "NPM Library", "StoryBook", "SASS"]
  },
  {
    role: "FrontEnd Developer (Trainee)",
    company: "Academia Geek",
    location: "Medellín, Colombia",
    period: "2022-02 — 2022-06",
    current: false,
    impactBadge: "El Inicio en 2022",
    highlights: [
      "Desarrollo de plataformas e-commerce con React.js, Redux y Firebase con diseño responsive mobile-first."
    ],
    stack: ["React.js", "Redux", "Firebase", "SASS"]
  }
];
---

<section id="experiencia" class="py-20 px-4 sm:px-6 max-w-5xl mx-auto scroll-mt-24">
  <div class="mb-10">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-brand/30 bg-brand/10 text-brand-hover text-xs font-mono font-medium mb-3">
      <Briefcase className="w-3.5 h-3.5" />
      Trayectoria Profesional
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
      Evolución & Experiencia
    </h2>
    <p class="text-ink-subtle text-sm sm:text-base mt-2 max-w-xl text-pretty">
      Más de 4 años de progreso constante: desde trainee en 2022 hasta desarrollador Full Stack liderando migraciones y arquitecturas críticas.
    </p>
  </div>

  <!-- Interactive Timeline with Compact Visual Cards -->
  <div class="relative border-l border-hairline-strong ml-3 sm:ml-4 pl-6 sm:pl-8 space-y-8">
    {experiences.map((exp) => (
      <div class="relative group">
        <!-- Node indicator dot -->
        <div class="absolute -left-[31px] sm:-left-[39px] top-2 flex items-center justify-center">
          <div class={`w-4 h-4 rounded-full border-2 transition-transform duration-300 group-hover:scale-125 ${
            exp.current
              ? 'bg-brand border-brand-accent shadow-[0_0_12px_rgba(99,102,241,0.6)]'
              : 'bg-surface-1 border-hairline-strong group-hover:border-brand-hover'
          }`} />
        </div>

        <!-- Experience Card -->
        <div class="p-5 sm:p-6 rounded-2xl border border-hairline bg-surface-1/70 backdrop-blur-sm transition-all duration-300 hover:border-hairline-strong hover:bg-surface-2/60">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-lg sm:text-xl font-bold text-ink group-hover:text-white transition-colors">
                  {exp.role}
                </h3>
                <span class="px-2 py-0.5 text-[10px] font-mono font-semibold text-brand-accent bg-brand-accent/10 border border-brand-accent/20 rounded-md">
                  {exp.impactBadge}
                </span>
                {exp.current && (
                  <span class="px-2 py-0.5 text-[10px] font-mono font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-md">
                    Actual
                  </span>
                )}
              </div>
              <div class="text-ink-muted font-medium text-xs sm:text-sm mt-0.5">
                {exp.company}
              </div>
            </div>

            <div class="flex items-center gap-3 text-xs font-mono text-ink-subtle">
              <span class="flex items-center gap-1">
                <Calendar className="w-3.5 h-3.5 text-ink-tertiary" />
                {exp.period}
              </span>
            </div>
          </div>

          <!-- Key Highlights -->
          <ul class="space-y-1.5 mb-4">
            {exp.highlights.map(item => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-ink-subtle leading-relaxed">
                <CheckCircle2 className="w-3.5 h-3.5 text-brand shrink-0 mt-0.5" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <!-- Stack Tags -->
          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-hairline">
            {exp.stack.map(tag => (
              <span class="px-2 py-0.5 text-[10px] font-mono text-ink-muted bg-surface-3/60 rounded">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
