---
import { Briefcase, Calendar, CheckCircle2 } from 'lucide-react';

const experiences = [
  {
    role: "Desarrollador Full Stack",
    company: "Asisya",
    location: "Bogotá, Colombia (Remoto)",
    period: "2025-06 — Actualidad",
    current: true,
    impactBadge: "PeritoYa & Muévelo",
    highlights: [
      "Lideré la migración del frontend de PeritoYa a React 19, Vite y Tailwind CSS, eliminando pérdidas de datos offline con Web Locks API e IndexedDB.",
      "Desarrollo de servicios backend en .NET 10 con Clean Architecture, CQRS (MediatR), EF Core, Dapper y caché distribuida con Redis.",
      "Desarrollo integral de Muévelo (Renting de vehículos): motor de cotización en tiempo real, gestión de archivos en MinIO S3 y Google Sheets API.",
      "Hardening de seguridad bancaria: protección contra ataques CSRF, rate limiting por IP, validación de firmas mágicas binarias y resolución de pentesting Aikido."
    ],
    stack: ["React 19", ".NET 10", "TypeScript", "Clean Arch", "CQRS", "PostgreSQL", "Redis", "Docker"]
  },
  {
    role: "Semi-senior FrontEnd Developer",
    company: "Ditech (Outsourcing para Finanzauto)",
    location: "Bogotá, Colombia (Remoto)",
    period: "2024-04 — 2025-05",
    current: false,
    impactBadge: "Financiera a Gran Escala",
    highlights: [
      "Desarrollo de módulos interactivos de alta fidelidad con React.js, Vite y Tailwind CSS para plataforma de crédito vehicular.",
      "Elaboración de código testeable, accesible y optimización de métricas Core Web Vitals para productos fintech de alto tráfico."
    ],
    stack: ["React.js", "Vite", "Tailwind CSS", "TypeScript"]
  },
  {
    role: "FrontEnd Developer",
    company: "Kutai",
    location: "Medellín, Colombia",
    period: "2022-06 — 2024-02",
    current: false,
    impactBadge: "Librerías NPM & Componentes",
    highlights: [
      "Desarrollo de aplicaciones web escalables con Next.js, TypeScript y SASS consumiendo APIs RESTful.",
      "Construcción y publicación de librerías NPM internas de componentes de diseño reutilizables con StoryBook y Rollup.js."
    ],
    stack: ["Next.js", "TypeScript", "NPM Library", "StoryBook", "SASS"]
  },
  {
    role: "FrontEnd Developer (Trainee)",
    company: "Academia Geek",
    location: "Medellín, Colombia",
    period: "2022-02 — 2022-06",
    current: false,
    impactBadge: "Fundamentos & Práctica",
    highlights: [
      "Desarrollo de plataformas e-commerce con React.js, Redux y Firebase con diseño responsive mobile-first y buenas prácticas de componentización."
    ],
    stack: ["React.js", "Redux", "Firebase", "SASS"]
  }
];
---

<section id="experiencia" class="py-20 px-4 sm:px-6 max-w-5xl mx-auto scroll-mt-24">
  <div class="mb-10">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-slate-200/90 dark:border-white/10 bg-white/80 dark:bg-zinc-900/80 text-slate-700 dark:text-zinc-300 text-xs font-mono font-medium mb-3 shadow-sm">
      <Briefcase className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400" />
      Trayectoria Profesional
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      Evolución &amp; Experiencia
    </h2>
    <p class="text-slate-600 dark:text-zinc-400 text-sm sm:text-base mt-2 max-w-xl text-pretty">
      Más de 4 años de progreso constante: desde trainee en 2022 hasta desarrollador Full Stack liderando migraciones críticas y arquitecturas en producción.
    </p>
  </div>

  <!-- Interactive Timeline with Compact Visual Cards -->
  <div class="relative border-l border-slate-200 dark:border-white/10 ml-3 sm:ml-4 pl-6 sm:pl-8 space-y-8">
    {experiences.map((exp) => (
      <div class="relative group">
        <!-- Node indicator dot -->
        <div class="absolute -left-[31px] sm:-left-[39px] top-2 flex items-center justify-center">
          <div class={`w-4 h-4 rounded-full border-2 transition-transform duration-300 group-hover:scale-125 ${
            exp.current
              ? 'bg-indigo-600 border-indigo-400 shadow-[0_0_12px_rgba(99,102,241,0.5)]'
              : 'bg-white dark:bg-zinc-900 border-slate-300 dark:border-white/20 group-hover:border-indigo-500'
          }`} />
        </div>

        <!-- Experience Card -->
        <div class="p-5 sm:p-6 rounded-2xl border border-slate-200/90 dark:border-white/10 bg-white/95 dark:bg-zinc-900/85 backdrop-blur-sm shadow-sm dark:shadow-md transition-all duration-300 hover:border-slate-300 dark:hover:border-white/20">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                  {exp.role}
                </h3>
                <span class="px-2 py-0.5 text-[10px] font-mono font-semibold text-indigo-700 dark:text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 rounded-md">
                  {exp.impactBadge}
                </span>
                {exp.current && (
                  <span class="px-2 py-0.5 text-[10px] font-mono font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-md">
                    Actual
                  </span>
                )}
              </div>
              <div class="text-slate-600 dark:text-zinc-300 font-medium text-xs sm:text-sm mt-0.5">
                {exp.company} &bull; <span class="text-slate-500 dark:text-zinc-400">{exp.location}</span>
              </div>
            </div>

            <div class="flex items-center gap-3 text-xs font-mono text-slate-500 dark:text-zinc-400">
              <span class="flex items-center gap-1">
                <Calendar className="w-3.5 h-3.5" />
                {exp.period}
              </span>
            </div>
          </div>

          <!-- Key Highlights -->
          <ul class="space-y-1.5 mb-4">
            {exp.highlights.map(item => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed">
                <CheckCircle2 className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0 mt-0.5" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <!-- Stack Tags -->
          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-slate-200/80 dark:border-white/10">
            {exp.stack.map(tag => (
              <span class="px-2 py-0.5 text-[10px] font-mono text-slate-700 dark:text-zinc-300 bg-slate-100 dark:bg-zinc-800 rounded">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
