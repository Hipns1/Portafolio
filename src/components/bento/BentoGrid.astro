---
import SpotlightCard from '../ui/SpotlightCard.tsx';
import InteractiveArchitecture from '../ui/InteractiveArchitecture.tsx';
import InteractiveTerminal from '../ui/InteractiveTerminal.tsx';
import { Shield, Zap, Terminal, ArrowUpRight, CheckCircle2, Server, Smartphone, Lock } from 'lucide-react';
---

<section id="proyectos" class="py-20 px-4 sm:px-6 max-w-6xl mx-auto scroll-mt-24">
  <!-- Section Title & Context -->
  <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-slate-200/90 dark:border-white/10 bg-white/80 dark:bg-zinc-900/80 text-xs font-mono font-medium text-slate-700 dark:text-zinc-300 mb-3 shadow-sm">
        <Zap className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400" />
        Sistemas &amp; Arquitectura
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Proyectos Clave en Producción
      </h2>
      <p class="text-slate-600 dark:text-zinc-400 text-sm sm:text-base mt-2 max-w-2xl text-pretty">
        Soluciones integrales diseñadas para resolver desafíos técnicos críticos: resiliencia offline en campo, motores de cotización en vivo y despliegues automatizados.
      </p>
    </div>

    <!-- Active Production Badge -->
    <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white dark:bg-zinc-900 border border-slate-200/90 dark:border-white/10 text-xs font-mono text-slate-700 dark:text-zinc-300 shadow-sm shrink-0">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>3 Sistemas activos en producción</span>
    </div>
  </div>

  <!-- FLAGSHIP INTERACTIVE ARCHITECTURE SIMULATOR -->
  <div class="mb-8">
    <InteractiveArchitecture client:visible />
  </div>

  <!-- EDITORIAL CASE STUDIES GRID (3 COLUMNS) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
    
    <!-- CASE STUDY 1: PERITOYA -->
    <SpotlightCard
      client:visible
      className="p-6 sm:p-7 flex flex-col justify-between group"
      spotlightColor="rgba(56, 189, 248, 0.12)"
    >
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-2.5 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400 bg-sky-500/10 border border-sky-500/20 rounded-md">
            PWA Offline-First
          </span>
          <span class="text-xs font-mono text-slate-500 dark:text-zinc-500">Asisya</span>
        </div>

        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
          PeritoYa: Peritajes en Campo
        </h3>

        <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
          Migración técnica a React 19 y arquitectura offline con Web Locks API para eliminar pérdida de datos y duplicidad entre pestañas de inspectores.
        </p>

        <!-- Technical Achievements List -->
        <ul class="space-y-2 mb-6 text-xs text-slate-600 dark:text-zinc-400">
          <li class="flex items-start gap-2">
            <CheckCircle2 className="w-3.5 h-3.5 text-sky-600 dark:text-sky-400 shrink-0 mt-0.5" />
            <span>Sincronización coordinada sin conflicto de tokens</span>
          </li>
          <li class="flex items-start gap-2">
            <CheckCircle2 className="w-3.5 h-3.5 text-sky-600 dark:text-sky-400 shrink-0 mt-0.5" />
            <span>Backend en .NET 10 con CQRS y caché Redis</span>
          </li>
        </ul>
      </div>

      <div class="pt-4 border-t border-slate-200/80 dark:border-white/10 flex flex-wrap gap-1.5">
        {['React 19', '.NET 10', 'Web Locks', 'PostgreSQL', 'Redis'].map(tag => (
          <span class="px-2 py-0.5 text-[10px] font-mono text-slate-700 dark:text-zinc-300 bg-slate-100 dark:bg-zinc-800 rounded">
            {tag}
          </span>
        ))}
      </div>
    </SpotlightCard>

    <!-- CASE STUDY 2: MUÉVELO RENTING -->
    <SpotlightCard
      client:visible
      className="p-6 sm:p-7 flex flex-col justify-between group"
      spotlightColor="rgba(99, 102, 241, 0.12)"
    >
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-2.5 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 rounded-md">
            Full Stack Renting
          </span>
          <span class="text-xs font-mono text-slate-500 dark:text-zinc-500">Asisya</span>
        </div>

        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
          Muévelo: Cotizador &amp; SaaS
        </h3>

        <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
          Portal público, cotizador de cuotas en tiempo real y panel de administración integral con almacenamiento de documentos en MinIO S3 y automatización.
        </p>

        <!-- Technical Achievements List -->
        <ul class="space-y-2 mb-6 text-xs text-slate-600 dark:text-zinc-400">
          <li class="flex items-start gap-2">
            <CheckCircle2 className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0 mt-0.5" />
            <span>Motor de cotización dinámico con validación server-side</span>
          </li>
          <li class="flex items-start gap-2">
            <CheckCircle2 className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0 mt-0.5" />
            <span>Integración automatizada con Google Sheets API</span>
          </li>
        </ul>
      </div>

      <div class="pt-4 border-t border-slate-200/80 dark:border-white/10 flex flex-wrap gap-1.5">
        {['React 19', '.NET 10', 'MinIO (S3)', 'Clean Arch', 'Dapper'].map(tag => (
          <span class="px-2 py-0.5 text-[10px] font-mono text-slate-700 dark:text-zinc-300 bg-slate-100 dark:bg-zinc-800 rounded">
            {tag}
          </span>
        ))}
      </div>
    </SpotlightCard>

    <!-- CASE STUDY 3: GITOPS & HARDENING -->
    <SpotlightCard
      client:visible
      className="p-6 sm:p-7 flex flex-col justify-between group"
      spotlightColor="rgba(16, 185, 129, 0.12)"
    >
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-2.5 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-md">
            DevOps &amp; Seguridad
          </span>
          <Shield className="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
        </div>

        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
          Infraestructura &amp; Hardening
        </h3>

        <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
          Pipeline autohospedado en servidor Linux con orquestación n8n, contenedores Docker aislados, Cloudflare Tunnel y resolución de pentesting Aikido.
        </p>

        <!-- Technical Achievements List -->
        <ul class="space-y-2 mb-6 text-xs text-slate-600 dark:text-zinc-400">
          <li class="flex items-start gap-2">
            <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
            <span>Rate limiting por IP y validación de firmas binarias</span>
          </li>
          <li class="flex items-start gap-2">
            <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
            <span>Despliegues sin tiempo de inactividad con Caddy</span>
          </li>
        </ul>
      </div>

      <div class="pt-4 border-t border-slate-200/80 dark:border-white/10 flex flex-wrap gap-1.5">
        {['Docker', 'n8n', 'Cloudflare', 'Aikido', 'Linux'].map(tag => (
          <span class="px-2 py-0.5 text-[10px] font-mono text-slate-700 dark:text-zinc-300 bg-slate-100 dark:bg-zinc-800 rounded">
            {tag}
          </span>
        ))}
      </div>
    </SpotlightCard>

  </div>

  <!-- INTERACTIVE TERMINAL SECTION -->
  <div>
    <div class="flex items-center gap-2 mb-3">
      <Terminal className="w-4 h-4 text-slate-900 dark:text-white" />
      <span class="text-xs font-mono font-semibold text-slate-900 dark:text-white uppercase tracking-wider">
        Consola Interactiva del Desarrollador
      </span>
    </div>
    <InteractiveTerminal client:idle />
  </div>
</section>
