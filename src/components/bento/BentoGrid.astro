---
import SpotlightCard from '../ui/SpotlightCard.tsx';
import InteractiveArchitecture from '../ui/InteractiveArchitecture.tsx';
import InteractiveTerminal from '../ui/InteractiveTerminal.tsx';
import { Shield, Zap, CheckCircle2, Terminal } from 'lucide-react';
---

<section id="proyectos" class="py-20 px-4 sm:px-6 max-w-6xl mx-auto scroll-mt-24">
  <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-brand/30 bg-brand/10 text-brand-hover text-xs font-mono font-medium mb-3">
        <Zap className="w-3.5 h-3.5" />
        Sistemas en Producción
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Arquitectura & Proyectos Clave
      </h2>
      <p class="text-slate-600 dark:text-zinc-400 text-sm sm:text-base mt-2 max-w-xl text-pretty">
        Explora interactivamente los flujos de datos, la resiliencia offline y la automatización CI/CD.
      </p>
    </div>

    <!-- Live indicator badge -->
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-white/10 text-xs font-mono text-slate-700 dark:text-zinc-300 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
      <span>3 Sistemas en producción activa</span>
    </div>
  </div>

  <!-- INTERACTIVE SYSTEM EXPLORER WIDGET (FLAGSHIP) -->
  <div class="mb-8">
    <InteractiveArchitecture client:visible />
  </div>

  <!-- BENTO GRID CARDS -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
    
    <!-- CARD 1: Muévelo Renting Engine -->
    <SpotlightCard
      client:visible
      className="p-6 sm:p-7 flex flex-col justify-between group"
      spotlightColor="rgba(56, 189, 248, 0.15)"
    >
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-2.5 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 bg-sky-500/10 border border-sky-500/20 rounded-md">
            Full Stack Renting
          </span>
          <span class="text-xs font-mono text-slate-500 dark:text-zinc-500">Asisya</span>
        </div>

        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-brand-accent transition-colors">
          Muévelo: Cotizador &amp; Renting
        </h3>

        <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
          Sitio público, cotizador en vivo y panel administrativo.
        </p>

        <!-- Visual Metrics Chips -->
        <div class="grid grid-cols-2 gap-2 mb-4">
          <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-zinc-900/80 border border-slate-200/80 dark:border-white/5 text-center">
            <div class="text-sm font-bold text-brand-accent font-mono">React 19</div>
            <div class="text-[10px] text-slate-500 dark:text-zinc-500">Frontend Ágil</div>
          </div>
          <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-zinc-900/80 border border-slate-200/80 dark:border-white/5 text-center">
            <div class="text-sm font-bold text-indigo-600 dark:text-indigo-400 font-mono">.NET 10</div>
            <div class="text-[10px] text-slate-500 dark:text-zinc-500">CQRS + MinIO</div>
          </div>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-200/80 dark:border-white/10 flex flex-wrap gap-1.5">
        {['React 19', '.NET 10', 'MinIO (S3)', 'PostgreSQL'].map(tag => (
          <span class="px-2 py-0.5 text-[10px] font-mono text-slate-700 dark:text-zinc-300 bg-slate-100 dark:bg-zinc-800 rounded">
            {tag}
          </span>
        ))}
      </div>
    </SpotlightCard>

    <!-- CARD 2: Seguridad & Hardening -->
    <SpotlightCard
      client:visible
      className="p-6 sm:p-7 flex flex-col justify-between group"
      spotlightColor="rgba(16, 185, 129, 0.15)"
    >
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-2.5 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-md">
            Seguridad &amp; Pentesting
          </span>
          <Shield className="w-4 h-4 text-emerald-500 dark:text-emerald-400" />
        </div>

        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
          Controles de Seguridad
        </h3>

        <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
          Auditorías de pentesting resueltas con protección bancaria:
        </p>

        <ul class="space-y-1.5 mb-4 text-xs font-mono text-slate-600 dark:text-zinc-400">
          <li class="flex items-center gap-1.5">
            <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 dark:text-emerald-400 shrink-0" />
            <span>Rate limiting por IP + CSRF</span>
          </li>
          <li class="flex items-center gap-1.5">
            <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 dark:text-emerald-400 shrink-0" />
            <span>Validación de firmas binarias</span>
          </li>
          <li class="flex items-center gap-1.5">
            <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 dark:text-emerald-400 shrink-0" />
            <span>Auditorías con Aikido</span>
          </li>
        </ul>
      </div>

      <div class="pt-3 border-t border-slate-200/80 dark:border-white/10 flex flex-wrap gap-1.5">
        {['xUnit', 'Vitest', 'CSP Headers', 'Role RBAC'].map(tag => (
          <span class="px-2 py-0.5 text-[10px] font-mono text-slate-700 dark:text-zinc-300 bg-slate-100 dark:bg-zinc-800 rounded">
            {tag}
          </span>
        ))}
      </div>
    </SpotlightCard>

    <!-- CARD 3: Background & Mentalidad Mecatrónica -->
    <SpotlightCard
      client:visible
      className="p-6 sm:p-7 flex flex-col justify-between group"
      spotlightColor="rgba(168, 85, 247, 0.15)"
    >
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-2.5 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400 bg-purple-500/10 border border-purple-500/20 rounded-md">
            Formación
          </span>
          <span class="text-xs font-mono text-slate-500 dark:text-zinc-500">Cartagena / UTB</span>
        </div>

        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
          Ingeniería Mecatrónica
        </h3>

        <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
          La formación en sistemas de control y programación aporta disciplina para diseñar arquitecturas tolerantes a fallos.
        </p>

        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-zinc-900/80 border border-slate-200/80 dark:border-white/5 text-[11px] font-mono text-slate-600 dark:text-zinc-400 space-y-1">
          <div>&bull; Idiomas: Español (Nativo), Inglés (B2)</div>
          <div>&bull; Scrum Certified</div>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-200/80 dark:border-white/10 flex flex-wrap gap-1.5">
        <span class="px-2 py-0.5 text-[10px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 rounded">
          Clean Code
        </span>
        <span class="px-2 py-0.5 text-[10px] font-mono text-slate-700 dark:text-zinc-300 bg-slate-100 dark:bg-zinc-800 rounded">
          Sistemas de Control
        </span>
      </div>
    </SpotlightCard>

  </div>

  <!-- INTERACTIVE TERMINAL SECTION -->
  <div class="mt-8">
    <div class="flex items-center gap-2 mb-3">
      <Terminal className="w-4 h-4 text-brand" />
      <span class="text-xs font-mono font-semibold text-slate-900 dark:text-white uppercase tracking-wider">
        Consola de Comandos Interactiva
      </span>
    </div>
    <InteractiveTerminal client:idle />
  </div>
</section>
